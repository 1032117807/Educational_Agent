# Copy this file to .env and fill in only the services you use.
# Get a Tavily key at https://app.tavily.com/
TAVILY_API_KEY=

# Server
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://learning:change-me@localhost:5432/learning
# Docker Compose uses this owner account only for Alembic migrations. API and
# worker containers must use the separate non-owner APP_DB_USER role below.
POSTGRES_PASSWORD=replace-with-a-long-migration-password
APP_DB_USER=learning_app
APP_DB_PASSWORD=replace-with-a-long-runtime-password
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=replace-with-a-long-redis-password
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=learning
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Chat model, preferred provider: DeepSeek (OpenAI-compatible).
# DeepSeek does not supply embedding or rerank APIs; configure those separately.
LEARNING_AI_ENABLED=false
LEARNING_AI_PROVIDER=openai_compatible
LEARNING_AI_API_KEY=
LEARNING_AI_BASE_URL=https://api.deepseek.com
LEARNING_AI_CHAT_MODEL=deepseek-chat
# Alternative OpenAI-compatible chat providers:
# SiliconFlow: LEARNING_AI_BASE_URL=https://api.siliconflow.cn/v1
# Alibaba DashScope compatible mode: LEARNING_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding provider: local FastEmbed, or SiliconFlow/OpenAI-compatible API.
LEARNING_AI_EMBEDDING_PROVIDER=local
LEARNING_AI_EMBEDDING_API_KEY=
LEARNING_AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LEARNING_AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LEARNING_AI_EMBEDDING_LOCAL_FILES_ONLY=true
LEARNING_AI_EMBEDDING_MODEL_DIR=models/fastembed/bge-small-zh-v1.5
LEARNING_AI_EMBEDDING_DIMENSIONS=512

# Optional rerank service. DeepSeek cannot rerank. Use SiliconFlow or Alibaba
# compatible rerank API when an adapter is enabled in deployment.
LEARNING_AI_RERANK_ENABLED=false
LEARNING_AI_RERANK_PROVIDER=siliconflow
LEARNING_AI_RERANK_API_KEY=
LEARNING_AI_RERANK_BASE_URL=https://api.siliconflow.cn/v1
LEARNING_AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LEARNING_AI_RERANK_CANDIDATE_LIMIT=24
LEARNING_AI_CONTEXTUAL_RETRIEVAL_ENABLED=true
LEARNING_AI_QUERY_REWRITE_ENABLED=true
LEARNING_AI_AGENTIC_RAG_ENABLED=true
LEARNING_AI_LOCAL_RERANKER_ENABLED=true
LEARNING_AI_SAAS_HYBRID_RETRIEVAL_ENABLED=true
LEARNING_AI_SUBAGENT_RUNTIME_ENABLED=true
LEARNING_AI_MEMORY_RETRIEVAL_ENABLED=true
LEARNING_AI_MEMORY_CONFLICT_RESOLUTION_ENABLED=true

# OCR: try a compatible vision API first, then fall back to local PaddleOCR
# running on the server CPU. Qwen VL is available from SiliconFlow or Alibaba.
LEARNING_AI_OCR_ENABLED=true
LEARNING_AI_OCR_DEVICE=cpu
LEARNING_AI_OCR_API_ENABLED=false
LEARNING_AI_OCR_API_KEY=
LEARNING_AI_OCR_API_BASE_URL=https://api.siliconflow.cn/v1
LEARNING_AI_OCR_API_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LEARNING_AI_OCR_API_TIMEOUT_SECONDS=45

# Optional web search, server-side only.
TAVILY_API_KEY=
# Optional desktop-to-Web Agent bridge. Use an access token from the same SaaS
# organization and give each desktop installation a stable unique identifier.
LEARNING_SAAS_API_URL=http://127.0.0.1:8000
LEARNING_SAAS_ACCESS_TOKEN=
LEARNING_SAAS_REFRESH_TOKEN=
LEARNING_DESKTOP_COMPANION_ID=

# Agent Harness Phase A
LEARNING_AGENT_RUNTIME_V2=true
LEARNING_SKILL_PROGRESSIVE_DISCLOSURE=true
LEARNING_CONTEXT_STATUS_BAR=true
LEARNING_AGENT_MAX_ITERATIONS=10
LEARNING_AGENT_MAX_TOOL_CALLS=12
LEARNING_AGENT_MAX_SAME_TOOL_RETRIES=2
LEARNING_AGENT_MAX_RAG_SEARCHES=4
LEARNING_AGENT_MAX_SUBAGENTS=4
LEARNING_AGENT_MAX_CONTEXT_TOKENS=12000
LEARNING_AGENT_MAX_TOOL_RESULT_CHARS=12000
