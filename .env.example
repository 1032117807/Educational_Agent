# Copy this file to .env and fill in only the services you use.
# Get a Tavily key at https://app.tavily.com/
TAVILY_API_KEY=

# Server
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://learning:change-me@localhost:5432/learning
# Docker Compose uses this owner account only for Alembic migrations. API and
# worker containers must use the separate non-owner APP_DB_USER role below.
POSTGRES_PASSWORD=replace-with-a-long-migration-password
APP_DB_USER=learning_app
APP_DB_PASSWORD=replace-with-a-long-runtime-password
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=replace-with-a-long-redis-password
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=learning
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Optional: OpenAI-compatible AI service. Keep this on the server only.
LEARNING_AI_ENABLED=false
LEARNING_AI_PROVIDER=openai
LEARNING_AI_API_KEY=
LEARNING_AI_BASE_URL=
LEARNING_AI_CHAT_MODEL=gpt-4.1-mini

# Local embedding model: no API key when bundled/downloaded locally.
LEARNING_AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LEARNING_AI_EMBEDDING_LOCAL_FILES_ONLY=true
LEARNING_AI_EMBEDDING_MODEL_DIR=models/fastembed/bge-small-zh-v1.5
LEARNING_AI_EMBEDDING_DIMENSIONS=384

# Optional web search, server-side only.
TAVILY_API_KEY=
